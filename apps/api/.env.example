# Copiar como apps/api/.env y cargar con shell antes de iniciar (ver docs).
PORT=4000
## Identidad: local conserva el flujo anterior; firebase activa Authentication sin SMTP.
## Consulta docs/FIREBASE_AUTH.md antes de cambiar de proveedor.
AUTH_PROVIDER=local
# AUTH_PROVIDER=firebase
# FIREBASE_WEB_API_KEY=API_KEY_WEB_DEL_PROYECTO_FIREBASE
WEB_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql://qapath:qapath_dev_only@localhost:5432/qapath_academy
NODE_ENV=development

# MariBug: clave privada Gemini (distinta de la API key de Firebase).
# Usar un proyecto gratuito sin habilitar facturación si no deseas pagar.
QA_AI_ENABLED=false
# GEMINI_API_KEY=tu_clave_privada
QA_AI_MODEL=gemini-2.5-flash

# URL visible para estudiantes
APP_URL=http://localhost:3000
# Correo real: Resend API y remitente verificado. NO subir secretos al repositorio.
# RESEND_API_KEY=re_...
# EMAIL_FROM=QAPath Academy <no-reply@tudominio.com>
# Solo para desarrollo local: imprime enlaces privados de verificación en la terminal.
EMAIL_TRANSPORT=console
# OBLIGATORIO para MFA (32 bytes = 64 caracteres hexadecimales). Generar con Node crypto.
MFA_ENCRYPTION_KEY=REEMPLAZAR_CON_64_CARACTERES_HEXADECIMALES
# Transporte solo para pruebas E2E locales (no producción):
# EMAIL_TRANSPORT=test-inbox
# TEST_INBOX_DIR=C:/ProyectosIA/QAPathAcademy/qapath-academy/.local-mailbox

# Opción Firebase: escribir un documento en Firestore para la extensión oficial
# Trigger Email (la extensión REQUIERE configurar un servidor SMTP en Firebase).
# EMAIL_TRANSPORT=firebase
# FIREBASE_PROJECT_ID=mi-proyecto-firebase
# FIREBASE_SERVICE_ACCOUNT_EMAIL=firebase-adminsdk-xxxxx@mi-proyecto-firebase.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_MAIL_COLLECTION=mail
# Alternativa preferible en desarrollo local: usa un JSON fuera del repositorio
# GOOGLE_APPLICATION_CREDENTIALS=C:/ruta/privada/firebase-service-account.json
# FIREBASE_PROJECT_ID=mi-proyecto-firebase
# EMAIL_TRANSPORT=firebase
# Nota: FIREBASE_SERVICE_ACCOUNT_EMAIL es una identidad técnica, NO el remitente.
# Configura el remitente y SMTP dentro de la extensión Trigger Email.

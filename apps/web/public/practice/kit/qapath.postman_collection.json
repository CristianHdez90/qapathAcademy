    {
      "name": "Datos",
      "item": [
        {
          "name": "Cotización por fila CSV",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/practice/quotes",
            "body": {
              "mode": "raw",
              "raw": "{\"productId\":\"{{caseProduct}}\",\"quantity\":{{caseQuantity}},\"coupon\":\"{{caseCoupon}}\",\"shipping\":\"{{caseShipping}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set('caseProduct', pm.iterationData.get('productId') || 'basic');",
                  "pm.variables.set('caseQuantity', Number(pm.iterationData.get('quantity') ?? 3));",
                  "pm.variables.set('caseCoupon', pm.iterationData.get('coupon') ?? 'QA10');",
                  "pm.variables.set('caseShipping', pm.iterationData.get('shipping') || 'delivery');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const expected = Number(pm.iterationData.get('expectedStatus') || 200);",
                  "pm.test('Status de esta fila', () => pm.response.to.have.status(expected));",
                  "const json = pm.response.json();",
                  "pm.test('Sandbox', () => pm.expect(json.sandbox).to.eql(true));",
                  "if (expected === 200) pm.test('Total de esta fila', () => pm.expect(json.data.total).to.eql(Number(pm.iterationData.get('expectedTotal') || 104500)));",
                  "else pm.test('Error explicado', () => pm.expect(typeof json.error).to.eql('string'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
